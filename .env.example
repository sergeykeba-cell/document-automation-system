# Copy this file to .env and fill in your own values.
# Never commit the real .env file — it's already covered by .gitignore.

# --- App security ---
# Used for session/JWT signing. Generate a strong random value, e.g.:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_me_to_a_long_random_string

# --- Database ---
DATABASE_URL=sqlite:///./data/app.db

# --- First admin account (used only if a seed/create-admin step reads it) ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me

# --- App settings ---
APP_ENV=development
DEBUG=true

# Max rows accepted per Excel import (protects against accidental huge uploads)
MAX_IMPORT_ROWS=50000
